<% if(!items.length){ %><p>Tu carrito está vacío. ¡Descubrí algo que te guste!</p><a class="btn btn-primary" href="/">Volver al inicio</a><% }else{ %><div class="cart-layout"><section><% items.forEach(item=>{ %><article class="cart-row"><div class="cart-icon"><%= item.emoji||'📦' %></div><div><h3><a href="/products/<%= item.id %>"><%= item.name %></a></h3><p><%= item.price.toLocaleString('es-AR') %> puntos por unidad</p><div class="quantity-actions"><form action="/cart/decrease/<%= item.id %>" method="post"><button aria-label="Disminuir cantidad">−</button></form><strong><%= item.quantity %></strong><form action="/cart/increase/<%= item.id %>" method="post"><button aria-label="Aumentar cantidad" <%= item.quantity>=item.stock?'disabled':'' %>>+</button></form></div><p>Subtotal: <strong><%= item.subtotal.toLocaleString('es-AR') %> puntos</strong></p></div></article><% }) %></section><aside class="summary"><h2>Resumen</h2><p>Total: <strong><%= total.toLocaleString('es-AR') %> puntos</strong></p><a class="btn btn-primary full" href="/checkout">Ir a checkout</a><form action="/cart/clear" method="post"><button class="btn btn-outline full">Vaciar carrito</button></form></aside></div><% } %>