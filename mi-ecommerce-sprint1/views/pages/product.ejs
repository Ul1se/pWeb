<%- include('../partials/header') %><div class="container page-space"><p class="breadcrumb"><a href="/">Inicio</a> / <%= product.category %> / <%= product.name %></p><section class="detail"><div class="detail-art" aria-label="Ilustración de <%= product.name %>"><%= product.emoji %></div><div class="detail-info"><span class="eyebrow"><%= product.category %></span><h1><%= product.name %></h1><p><%= product.description %></p><div class="points"><%= product.points.toLocaleString('es-AR') %> <span>puntos</span></div><p class="muted">Disponible para canjear · Entrega a coordinar</p><button class="btn btn-primary" data-add-id="<%= product.id %>" data-name="<%= product.name %>" data-points="<%= product.points %>" data-emoji="<%= product.emoji %>">🛒 Agregar al carrito</button><a class="btn btn-outline" href="/cart">Ver carrito</a><p id="add-feedback" role="status" aria-live="polite"></p></div></section><h2 class="section-title">Productos relacionados</h2><div class="product-grid"><% related.forEach(item=>{ %><%- include('../partials/productCard',{item}) %><% }) %></div><h2 class="section-title">Otras categorías</h2><%- include('../partials/categories') %></div><%- include('../partials/footer') %>