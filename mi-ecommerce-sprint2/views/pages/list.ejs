<div class="container page-space"><h1><%= typeof heading!=='undefined'?heading:'Todos los productos' %></h1><form action="/products" method="get"><label for="sort">Ordenar por precio</label> <select name="sort" id="sort"><option value="">Sin ordenar</option><option value="asc" <%= sort==='asc'?'selected':'' %>>Menor a mayor</option><option value="desc" <%= sort==='desc'?'selected':'' %>>Mayor a menor</option></select> <button class="btn btn-outline">Ordenar</button></form><% if(!products.length){ %><p>No encontramos productos. <a href="/products">Ver catálogo</a></p><% }else{ %><div class="product-grid"><% products.forEach(item=>{ %><%- include('../partials/productCard',{item}) %><% }) %></div><% } %></div>