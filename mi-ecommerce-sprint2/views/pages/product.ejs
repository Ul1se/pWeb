<div class="container page-space"><p class="breadcrumb"><a href="/">Inicio</a> / <%= product.category %> / <%= product.name %></p><section class="detail"><div class="detail-art"><%= product.emoji||'📦' %></div><div class="detail-info"><span class="eyebrow"><%= product.category %></span><h1><%= product.name %></h1><p><%= product.description %></p><div class="points"><%= product.price.toLocaleString('es-AR') %> <span>puntos</span></div><% if(product.stock===0){ %><p class="stock-badge">Sin stock</p><button class="btn" disabled>Sin stock</button><% }else{ %><form action="/cart/add/<%= product.id %>" method="post"><button class="btn btn-primary" type="submit">🛒 Agregar al carrito</button></form><% } %><a class="btn btn-outline" href="/cart">Ver carrito</a></div></section><h2 class="section-title">Productos relacionados</h2><% if(related.length){ %><div class="product-grid"><% related.forEach(item=>{ %><%- include('../partials/productCard',{item}) %><% }) %></div><% }else{ %><p>No hay productos relacionados disponibles.</p><% } %></div>