<a class="product-card" href="/products/<%= item.id %>"><div class="product-art"><span><%= item.emoji||'📦' %></span></div><div class="product-info"><small><%= item.category %></small><h3><%= item.name %></h3><strong><%= item.price.toLocaleString('es-AR') %> puntos</strong><% if(item.stock===0){ %><span class="stock-badge">Sin stock</span><% } %><span class="view-detail">Ver producto ↗</span></div></a>