<%- include('../partials/header') %><div class="container auth-wrap"><section class="auth-card"><span class="eyebrow">SUMATE A PUNTOSCLUB</span><h1>Crear una cuenta</h1><p class="muted">Completá tus datos para registrarte.</p><form id="register-form" action="/register" method="post" novalidate><label for="name">Nombre</label><input type="text" id="name" name="name" autocomplete="name" required><label for="surname">Apellido</label><input type="text" id="surname" name="surname" autocomplete="family-name" required><label for="email">Correo electrónico</label><input type="email" id="email" name="email" autocomplete="email" required><label for="password">Contraseña</label><input type="password" id="password" name="password" autocomplete="new-password" required minlength="8"><button class="btn btn-primary full" type="submit">Registrarse</button></form><p id="auth-feedback" role="status"><%= error || "" %></p><p>¿Ya tenés cuenta? <a href="/login">Iniciá sesión</a></p><a href="/">← Volver al inicio</a></section></div><%- include('../partials/footer') %>